{
  "name": "visa-matrix-backend",
  "version": "1.0.0",
  "description": "Visa Matrix ERP Backend API",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --import ./tools/env-for-tests.js --test",
    "worker": "node src/server.js",
    "seed:admin": "node seed-admin.js",
    "convert:forms": "node tools/form-converter/index.js",
    "build": "node tools/build-check.js",
    "lint": "eslint src routes test tools --max-warnings=0"
  },
  "keywords": [
    "visa",
    "erp",
    "backend",
    "nodejs",
    "express",
    "supabase"
  ],
  "author": "Visa Matrix",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}
